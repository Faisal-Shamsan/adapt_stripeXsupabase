NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used only by tests/ and scripts/
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Stripe Connect platform (organisers' test account)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_CONNECT_COUNTRY=DE
# Platform pays Stripe processing fees, so the application fee has a fixed part:
# fee = floor(amount * bps / 10000) + fixed, capped at amount
PLATFORM_FEE_BPS=300
PLATFORM_FEE_FIXED_CENTS=25

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alternative model provider for demos: set AI_PROVIDER=nebius and a Nebius Token Factory key
AI_PROVIDER=anthropic
NEBIUS_API_KEY=
NEBIUS_MODEL=moonshotai/Kimi-K2.6
NEBIUS_FALLBACK_MODELS=zai-org/GLM-5.3,Qwen/Qwen3-235B-A22B-Instruct-2507
